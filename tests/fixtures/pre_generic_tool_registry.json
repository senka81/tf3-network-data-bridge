  "tf3_cargo_network_scan": {
    "handler": "tool_cargo_network_scan",
    "inputSchema": {
      "type": "object",
      "properties": {
        "town_contains": {
          "type": "string",
          "description": "Optional town substring; omit to scan whole save"
        },
        "cargo": {
          "type": "string",
          "description": "Optional cargo code, e.g. MEAT"
        },
        "only_unmet": {
          "type": "boolean",
          "description": "Default true"
        },
        "limit": {
          "type": "integer",
          "description": "Maximum cargo needs in output, default 20, max 100"
        },
        "factories_per_need": {
          "type": "integer",
          "description": "Default 3, max 5"
        },
        "input_sources_per_factory": {
          "type": "integer",
          "description": "Default 2, max 5"
        },
        "sort_by": {
