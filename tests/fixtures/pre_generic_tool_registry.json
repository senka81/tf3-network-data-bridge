  },
  "tf3_station_catchment": {
    "handler": "tool_station_catchment",
    "inputSchema": {
      "type": "object",
      "properties": {
        "town": {
          "type": "string"
        },
        "name_contains": {
          "type": "string"
        },
        "station_group_id": {
          "type": "string"
        },
        "include_sample_ids": {
          "type": "boolean",
          "description": "default false"
        },
        "view": {
          "type": "string",
          "enum": [
            "entities",
            "groups"
          ],
          "description": "default entities; groups combines station entities with conservative unique coverage bounds"
        },
        "limit": {
          "type": "integer",
          "description": "default 25, maximum 100"
        }
      }
    }
  },
  "tf3_town_coverage": {
    "handler": "tool_town_coverage",
    "inputSchema": {
      "type": "object",
      "properties": {
        "town": {
          "type": "string",
          "description": "Required town name; substring accepted only if unambiguous"
        },
        "sort_by": {
          "type": "string",
